# Glob API URL
VITE_APP_BASE_API=/api

VITE_APP_API_BASE_URL=https://xxxx.com
VITE_APP_API_KEY=sk-xxxxx

# 玻璃检测部门智能体（FastAPI + LangGraph）服务地址
VITE_AGENT_API_BASE_URL=http://127.0.0.1:8000
